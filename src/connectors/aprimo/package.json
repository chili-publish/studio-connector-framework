{
  "name": "aprimo-connector",
  "description": "Browse, search, and place assets from your Aprimo DAM.",
  "version": "1.0.0",
  "author": {
    "name": "CHILI publish",
    "email": "info@chili-publish.com",
    "url": "https://github.com/chili-publish"
  },
  "config": {
    "type": "media",
    "connectorName": "Aprimo",
    "iconUrl": "https://studio-cdn.chiligrafx.com/shared/demo-connectors/Aprimo_logo.svg",
    "options": {
      "BASE_URL": null,
      "META_DATA_FIELDS": "",
      "SUPPORTED_FILE_TYPES": "JPG, PNG, PDF, TIF",
      "DEBUG_LOG": "false"
    },
    "mappings": {},
    "supportedAuth": ["oAuth2ClientCredentials"]
  },
  "license": "MIT",
  "main": "out/connector.js",
  "dependencies": {
    "typescript": "^5.2.2",
    "@chili-publish/studio-connectors": "^1.45.0"
  },
  "scripts": {
    "build": "yarn connector-cli build"
  },
  "devDependencies": {
    "@chili-publish/connector-cli": "^1.12.1"
  }
}
