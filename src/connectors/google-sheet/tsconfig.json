{
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2020"],
    "noEmitHelpers": true,
    "module": "ES2020",
    "outDir": "out",
    "target": "ES2020",
    "moduleResolution": "Bundler",
    "preserveConstEnums": false,
    "esModuleInterop": false,
    "removeComments": true,
    "declaration": false,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "out"]
}
