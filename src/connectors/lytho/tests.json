    {
      "id": "32",
      "name": "download - highres (print intent, AI)",
      "descr": "The case that pins the highres intent split. Every other highres fixture is a type the print and animation native sets agree on, so collapsing the intent ternary to either set alone leaves them all passing. An .ai is print-native but not animation-native, so it is the cheapest input that tells the two branches apart: it must keep /assets/grafx/assets/:id/content here, while case 30 sends the same asset to the rasterized twin on animation. If this ever routes to /hrpreview, highres has stopped distinguishing the intents.",
      "method": "download",
      "arguments": {
        "id": "6c3d4e5f60718293a4b5c6d7",
        "download_type": "highres",
        "download_intent": "print",
        "context": {}
      },
      "asserts": {
        "fetch": [
          {
            "url": "/assets/grafx/assets/6c3d4e5f60718293a4b5c6d7",
            "method": "GET",
            "count": 1,
            "response": {
              "status": 200,
              "headers": { "content-type": "application/json" },
              "body": {
                "id": "6c3d4e5f60718293a4b5c6d7",
                "name": "Illustrator Asset",
