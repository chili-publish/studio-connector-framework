      "id": "8",
      "name": "download - fullres (web intent, raster original)",
      "descr": "On the web (on-screen) intent, a PNG/JPEG asset at fullres is served as its original bytes via /assets/grafx/assets/:id/content — GraFx accepts PNG/JPEG on-screen, so no conversion. The file type is resolved first via GET /assets/grafx/assets/:id.",
      "method": "download",
      "arguments": {
        "id": "69de58c9bb8c4c6895418fa0",
        "download_type": "fullres",
        "download_intent": "web",
        "context": {}
