  "tests": [
    {
      "id": "1",
      "name": "query - no filter",
      "descr": "Calls POST /search/grafx/api/v1/search with empty terms and default pagination",
      "method": "query",
      "arguments": {
        "options": {
          "pageToken": null,
          "pageSize": 20,
          "filter": [],
          "collection": null,
          "sortBy": null,
          "sortOrder": null
        },
        "context": {}
      },
      "asserts": {
        "fetch": [
          {
            "url": "/search/grafx/api/v1/search",
            "method": "POST",
            "count": 1,
            "response": {
              "status": 200,
              "headers": { "content-type": "application/json" },
              "body": {
                "totalHits": 1,
                "from": 0,
                "size": 20,
                "hits": [
                  {
                    "id": "69de58c9bb8c4c6895418fa0",
                    "name": "Test Asset",
                    "fileName": "test-asset.jpg",
                    "extension": "jpg",
                    "fileType": "image/jpeg",
                    "width": 1920,
                    "height": 1080,
                    "tags": [{ "id": "tag-1", "name": "Product" }]
                  }
                ]
              }
            }
          }
        ]
      }
    },
